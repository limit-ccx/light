# ================================================================
# 环境变量样例：复制为 .env（docker-compose 会自动读取）并替换为强随机值。
# 默认值仅用于本地开发（中间件端口已绑定 127.0.0.1）；
# 任何对外/生产部署必须显式设置全部变量（SEC-P1-6）。
# 生成强随机值：openssl rand -base64 24
# ================================================================

# ---- 应用（必填，生产不设则启动失败/功能不可用）----
# DeepSeek 密钥（旧密钥已泄露，必须先在控制台吊销再填新值）
AI_API_KEY=
# 真实 Embedding 服务密钥（默认 SiliconFlow 的 BAAI/bge-m3，有免费额度；
# 不配置则降级为 LLM 伪向量，仅限开发环境）
AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# AI_EMBEDDING_MODEL=BAAI/bge-m3
# JWT 签名密钥（prod profile 下为空或等于仓库默认值会拒绝启动）
JWT_SECRET=

# ---- MySQL（默认弱口令仅限本机开发）----
MYSQL_ROOT_PASSWORD=123456
MYSQL_WRITE_PASSWORD=write_password
MYSQL_READ_PASSWORD=read_password
# 应用连接主库使用的账号（与上面保持一致）
MYSQL_USERNAME=root
MYSQL_PASSWORD=123456

# ---- RabbitMQ ----
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ---- 向量库 PostgreSQL + pgvector ----
VECTOR_POSTGRES_PASSWORD=postgres123

# ---- MinIO 对象存储 ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ---- Grafana ----
GRAFANA_ADMIN_PASSWORD=admin

# ---- 其他（按需）----
# CORS_ALLOWED_ORIGINS=https://zhiguang.com
